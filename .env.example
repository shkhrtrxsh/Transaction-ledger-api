# HTTP server
PORT=3000

# PostgreSQL connection used by the API and migration CLI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transaction_ledger

# Dedicated database used by the integration suite. It is created automatically
# by the test global setup when it does not exist.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/transaction_ledger_test

# Maximum PostgreSQL pool size
DB_POOL_MAX=10
